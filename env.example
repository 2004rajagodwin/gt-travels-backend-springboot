# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/gt_travels_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# JWT (minimum 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=1
RATE_LIMIT_PER_MINUTE=10
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Booking timeouts (minutes)
SEAT_LOCK_MINUTES=10
PENDING_EXPIRY_MINUTES=15

# Fare calculation
APP_FARE_CONVENIENCE_FEE_PER_SEAT=30
APP_FARE_TAX_PERCENT=5
APP_FARE_DEFAULT_BOARDING_CHARGE=20

# Server
SERVER_PORT=8080
