# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/gt_travels_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# JWT (minimum 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Booking timeouts (minutes)
SEAT_LOCK_MINUTES=10
PENDING_EXPIRY_MINUTES=15

# Server
SERVER_PORT=8080
